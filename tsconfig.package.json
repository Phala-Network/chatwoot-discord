// Type declarations for the package's Worker entry (see "build:package"); its JavaScript is bundled by esbuild.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "lib",
    "types": ["./.cloudflare/types/index.d.ts"]
  },
  "include": ["src"]
}

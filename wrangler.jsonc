// Worker configuration. The CONFIG values below are placeholders: replace them with your
// Chatwoot URL, account ids, forum channel id, and agents before relying on the relay (see the
// configuration reference in README.md). Secrets are listed in .dev.vars.example and set with
// `wrangler secret put <NAME>`, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatwoot-discord",
  "main": "src/index.ts",
  // Keep in step with test/wrangler.test.jsonc; run `npm run types` after changing it.
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  // Reconciliation sweep. The Free plan allows 5 cron triggers per account; this uses one.
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "vars": {
    "CONFIG": {
      "chatwoot": { "baseUrl": "https://chatwoot.example.com" },
      "accounts": [
        { "id": 1, "name": "Acme", "forumChannelId": "100000000000000002" },
        { "id": 2, "name": "Globex", "forumChannelId": "100000000000000002", "tag": "Globex" }
      ],
      "agents": [
        { "discordUserId": "100000000000000011", "chatwootUserId": 1, "tag": "Alice" },
        { "discordUserId": "100000000000000012", "chatwootUserId": 2 }
      ],
      "triage": { "userId": "100000000000000021", "name": "Triage bot", "draftLabels": ["Draft"] },
      "relay": { "maxChunks": 4, "topicAttribute": "topic", "linkAttribute": "discord_thread" }
    }
  }
}
